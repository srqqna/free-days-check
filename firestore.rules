rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function eventPath(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    // เจ้าของเว็บ (ล็อกอิน Google ด้วยอีเมลนี้เท่านั้น) หรือคนที่อยู่ใน admins/{uid}
    function isGlobalAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'mstandad@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    // แอดมินของนัด: คนสร้างนัด, คนที่ใส่รหัสแอดมินถูก, หรือแอดมินรวม
    function isEventAdmin(eventId) {
      return signedIn() && (
        isGlobalAdmin()
        || exists(/databases/$(database)/documents/events/$(eventId)/admins/$(request.auth.uid))
        || (exists(eventPath(eventId)) && get(eventPath(eventId)).data.owner == request.auth.uid)
      );
    }

    // ---------- ข้อมูลนัด ----------
    match /events/{eventId} {
      allow read: if true;

      // คนแรกที่สร้างเป็นเจ้าของ
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'name', 'hasCode', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      // แอดมินของนัดแก้ได้เฉพาะ confirmed (วันที่ยืนยัน) และ hasCode
      allow update: if isEventAdmin(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'hasCode'])
        && (!('confirmed' in request.resource.data)
            || (request.resource.data.confirmed is list && request.resource.data.confirmed.size() <= 60));

      allow delete: if isGlobalAdmin();

      // วันว่างของแต่ละคน: ทุกคนอ่านได้ เขียนได้เฉพาะของตัวเอง
      match /people/{uid} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'dates', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.dates is list
          && request.resource.data.dates.size() <= 400;
        allow delete: if signedIn() && (request.auth.uid == uid || isEventAdmin(eventId));
      }

      // แฮชของรหัสแอดมิน: ไม่มีใครอ่านได้ ตั้งได้ครั้งเดียวโดยคนสร้างนัด
      match /secret/admin {
        allow read: if false;
        allow create: if signedIn()
          && getAfter(eventPath(eventId)).data.owner == request.auth.uid
          && request.resource.data.keys().hasOnly(['hash'])
          && request.resource.data.hash is bytes
          && request.resource.data.hash.size() == 32;
        allow update: if false;
        allow delete: if isGlobalAdmin();
      }

      // คนที่ใส่รหัสแอดมินถูก: สร้างได้เมื่อรหัสตรงกับแฮช
      match /admins/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isGlobalAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 4
          && request.resource.data.code.size() <= 64
          && exists(/databases/$(database)/documents/events/$(eventId)/secret/admin)
          && hashing.sha256((eventId + ':' + request.resource.data.code).toUtf8())
             == get(/databases/$(database)/documents/events/$(eventId)/secret/admin).data.hash;
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == uid || isGlobalAdmin());
      }
    }

    // ---------- แอดมินรวม (เพิ่มเองใน Firebase Console) ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ปิดทุกอย่างที่เหลือ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
