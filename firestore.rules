rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // events/{eventId}/people/{uid}
    // ทุกคนอ่านได้ แต่ละคนเขียน/ลบได้เฉพาะเอกสารของตัวเอง (uid จาก Anonymous sign-in)
    match /events/{eventId}/people/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'dates', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.dates is list
        && request.resource.data.dates.size() <= 400;

      // ลบได้: เจ้าของชื่อเอง, แอดมินรวม (admins/{uid}) หรือคนสร้างนัดนี้
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || (exists(/databases/$(database)/documents/events/$(eventId))
                && get(/databases/$(database)/documents/events/$(eventId)).data.owner == request.auth.uid));
    }

    // events/{eventId} — ข้อมูลนัด: คนแรกที่สร้างเป็นเจ้าของ แก้ทีหลังไม่ได้
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['owner', 'name', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow update: if false;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // admins/{uid} — เพิ่มเองใน Firebase Console เท่านั้น
    // แต่ละคนอ่านได้แค่ของตัวเอง (เพื่อให้เว็บรู้ว่าเราเป็นแอดมินไหม)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ปิดทุกอย่างที่เหลือ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
