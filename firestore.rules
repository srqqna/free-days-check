rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // events/{eventId}/people/{uid}
    // ทุกคนอ่านได้ แต่ละคนเขียน/ลบได้เฉพาะเอกสารของตัวเอง (uid จาก Anonymous sign-in)
    match /events/{eventId}/people/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'dates', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.dates is list
        && request.resource.data.dates.size() <= 400;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ปิดทุกอย่างที่เหลือ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
